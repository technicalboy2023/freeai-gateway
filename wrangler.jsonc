{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freeai-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freeai-gateway-db",
      "database_id": "95300f6c-60dd-45fd-ac72-f03c7f6dd6e3"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/admin", "/admin/*"]
  }
}
